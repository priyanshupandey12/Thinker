NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://thinker:12345678@localhost:5432/thinker
LOG_LEVEL=info

# Required for GitHub sign-in. Use a random secret of at least 32 characters.
# GitHub OAuth callback: http://localhost:3000/api/auth/callback/github
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional until the mentor integration is implemented.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
