{
  "name": "thinker",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present build",
    "dev": "corepack pnpm --parallel --filter @thinker/api --filter @thinker/web dev",
    "dev:worker": "corepack pnpm --filter @thinker/api dev:worker",
    "typecheck": "corepack pnpm --recursive --if-present typecheck",
    "test": "corepack pnpm --recursive --if-present test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:generate": "corepack pnpm --filter @thinker/api db:generate",
    "db:migrate": "corepack pnpm --filter @thinker/api db:migrate",
    "db:seed": "corepack pnpm --filter @thinker/api db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
